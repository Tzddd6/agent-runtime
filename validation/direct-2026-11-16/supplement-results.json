      "answer": "{\"source\":\"def overlap_seconds(start_a, end_a, start_b, end_b):\\n    if end_a < start_a or end_b < start_b:\\n        raise ValueError(\\\"invalid\\\")\\n    if min(end_a, end_b) - max(start_a, start_b) < 0:\\n        return 0\\n    return min(end_a, end_b) - max(start_a, start_b)\\ndef bucket_index(timestamp, origin, width):\\n    if width <= 0:\\n        raise ValueError(\\\"invalid\\\")\\n    if timestamp >= 0:\\n        return (timestamp - origin) // width\\n    return -((origin - timestamp) // width) - 1\\ndef remaining_ttl(now, created, ttl):\\n    if ttl < 0:\\n        raise ValueError(\\\"invalid\\\")\\n    if now < created:\\n        return ttl\\n    if ttl - (now - created) < 0:\\n        return 0\\n    return ttl - (now - created)\\n\"}",
